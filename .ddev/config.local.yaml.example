# ── Overrides locales — NO commitear ──────────────────────────────────────────
# Copia este archivo como config.local.yaml y ajusta los puertos si hay conflictos.
# Ejemplo: cambia 5173 → 5274 si el puerto está ocupado por otro proyecto.

web_environment:
  - VITE_DEV_SERVER_URL=https://laravel-boilerplate.ddev.site:5173

web_extra_exposed_ports:
  - name: vite
    container_port: 5173
    http_port: 5172
    https_port: 5173
  - name: reverb
    container_port: 8080
    http_port: 8084
    https_port: 8085
