# ──────────────────────────────────────────────────────────────────────────────
# DDEV Environment Template
#
# Usage:
#   cp .env.ddev.example .env
#   # Replace <project-name> with your actual DDEV project name from config.yaml
#   ddev artisan key:generate
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://<project-name>.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database: PostgreSQL (DDEV default) ─────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

# ── Switch to MySQL ──────────────────────────────────────────────────────────
# 1. Edit .ddev/config.yaml: change database.type to "mysql" and version to "8"
# 2. Run: ddev restart
# 3. Then use these settings instead (comment out PostgreSQL above):
#
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=db
# DB_USERNAME=db
# DB_PASSWORD=db

# ── Session / Cache / Queue ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite HMR (DDEV) ─────────────────────────────────────────────────────────
# Must match APP_URL project name and the port exposed in config.yaml
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=https://<project-name>.ddev.site:5173
APP_DEVELOPER="Zygma Code"
