includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpat/phpat/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - phpstan-disallowed.neon
    - phpstan-baseline.neon

services:
    # Las reglas de arquitectura que son aserciones de dependencia. Viven
    # dentro de PHPStan para que no haya un segundo binario ni una segunda
    # pasada de CI.
    -
        class: Tests\Arch\ArchitectureRules
        tags:
            - phpat.test

parameters:
    paths:
        - app/
        - tests/Arch/

    # Los tests de un módulo viven dentro de él (R6), así que caen bajo `app/`.
    # No se analizan: exigirles el nivel del código de producción mete deuda
    # que no dice nada — 66 entradas de baseline la primera vez que se probó.
    excludePaths:
        - app/Modules/*/Tests/*
    level: 8

    # Un error dentro de un trait se atribuye al trait o a la clase que lo usa
    # segun como reparta PHPStan el trabajo entre workers, y esa cuenta cambia
    # entre DDEV y el runner. Sin esto el build falla por una entrada de
    # baseline que no encaja, no por un error de codigo: R56. Lo que evita que
    # la deuda se olvide es la fecha de vencimiento del baseline, no esto.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # `HasRepeatableFields` no lo usa ninguna pantalla de este repositorio,
        # y esa es su razon de ser: el boilerplate exporta piezas cuyo
        # consumidor es el proyecto hijo. Quien lo ejercita es su test, y los
        # tests de modulo estan excluidos arriba, asi que PHPStan lo ve huerfano.
        #
        # Va aqui y no al baseline a proposito: el baseline vence y esto no es
        # deuda, es una decision. Si algun dia una pantalla del boilerplate
        # repite campos, esta linea sobra y hay que quitarla.
        -
            identifier: trait.unused
            path: app/Modules/Platform/Traits/Livewire/HasRepeatableFields.php
